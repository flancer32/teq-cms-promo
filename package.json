{
  "name": "@flancer32/teq-cms-promo",
  "version": "0.3.0",
  "description": "Promo site for TeqCMS — a file-based CMS for agents building multilingual websites.",
  "type": "module",
  "keywords": [
    "teqfw",
    "tequila framework",
    "cms demo",
    "mustache",
    "ssr",
    "static site",
    "localization",
    "web"
  ],
  "homepage": "https://github.com/flancer32/teq-cms-promo#readme",
  "bugs": {
    "url": "https://github.com/flancer32/teq-cms-promo/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flancer32/teq-cms-promo.git"
  },
  "scripts": {
    "start": "teq web:start",
    "start:main": "teq web:start"
  },
  "dependencies": {
    "@flancer32/teq-cms": "github:flancer32/teq-cms#main",
    "@flancer32/teq-tmpl": "github:flancer32/teq-tmpl#main",
    "nunjucks": "^3.2.4"
  },
  "teqfw": {
    "fw": {
      "cli": {
        "command": {
          "default": "fl32:web:start"
        },
        "container": {
          "configurator": "./node_modules/@flancer32/teq-cms/bootstrap/di-config.mjs"
        }
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  }
}
