# Public configuration examples for the TeqCMS promotional site.
# Copy this sample to .env and adjust values for your deployment.
# The CLI loads .env once; process environment values override matching keys.
# Values are not expanded: write literal URLs and paths, not ${VARIABLE}.

# @flancer32/teq-cms: CMS publication and optional private agent inbox.
TEQ_CMS__BASE_URL=https://cms.teqfw.com
# Site publication is the default: no family registration is needed.
# Legacy selected-section mode (leave unset for this site):
# TEQ_CMS__PUBLICATION_FAMILIES=[{"prefix":"journal","presentation":"publication.html"}]
TEQ_CMS__AGENT_MESSAGE_ENABLED=false
# Optional shared inbox token; leave unset unless the inbox is enabled.
# TEQ_CMS__AGENT_MESSAGE_TOKEN=replace-with-your-own-token

# @flancer32/teq-tmpl: maintained locales and fallback locale.
TEQFW_TMPL__ALLOWED_LOCALES=en,ru
TEQFW_TMPL__DEFAULT_LOCALE=en
# Engine selection is owned by the standalone TeqCMS host, not teq-tmpl.
TEQFW_TMPL__ENGINE=nunjucks

# @teqfw/web: HTTP transport. Use 0.0.0.0 if remote access is required.
TEQFW_WEB__HOST=127.0.0.1
TEQFW_WEB__PORT=3000
TEQFW_WEB__TYPE=http
# Optional native TLS: change TYPE to https and supply certificate/key paths.
# TEQFW_WEB__TLS_CA=/path/to/ca.pem
# TEQFW_WEB__TLS_CERT=/path/to/server-cert.pem
# TEQFW_WEB__TLS_KEY=/path/to/server-key.pem
# TEQFW_WEB__TLS accepts an object from a typed cfg Source, not a dotenv string.

# @teqfw/log: an optional policy-file override consumed by the cfg log bridge.
# The host must explicitly apply TeqFw_Cfg_Log_Policy$ to activate this setting.
# The installed standalone CMS host does not currently apply that bridge.
# TEQFW_LOG__POLICY_FILE=etc/log.policy

# @teqfw/cfg defines Sources and key grammar, with no package settings of its own.
# @teqfw/cli computes applicationRoot/cwd/argv/dotenvPath as runtime facts.
# @teqfw/di uses package metadata and host composition, with no dotenv settings.
# Do not invent ROOT_PATH, application-root, CLI, or DI environment variables.
